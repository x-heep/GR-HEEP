//
// Waivers for pulp_platform/obi, first pulled into an X-HEEP Verilator
// build by the HLS dot-product accelerator example
// (hw/fpga/hls/common/dot_product) via the axi_obi bridges.

`verilator_config

lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_mux.sv" -match "Filename 'obi_mux' does not match MODULE name: 'obi_mux_intf'"
lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_intf.sv" -match "Filename 'obi_intf' does not match IFACE name: 'OBI_BUS'"
lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_atop_resolver.sv" -match "Filename 'obi_atop_resolver' does not match MODULE name: 'obi_atop_resolver_intf'"
lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_demux.sv" -match "Filename 'obi_demux' does not match MODULE name: 'obi_demux_intf'"
lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_err_sbr.sv" -match "Filename 'obi_err_sbr' does not match MODULE name: 'obi_err_sbr_intf'"
lint_off -rule DECLFILENAME -file "*/pulp_platform/obi/src/obi_xbar.sv" -match "Filename 'obi_xbar' does not match MODULE name: 'obi_xbar_intf'"
